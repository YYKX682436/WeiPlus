import java.util.ArrayDeque

open class XC_MethodHook {
    class MethodHookParam(val args: Array<Any?>, val thisObject: Any = Adapter()) {
        private val extras = HashMap<String, Any?>()
        var failed = false
        fun setObjectExtra(key: String, value: Any?) { extras[key] = value }
        fun getObjectExtra(key: String): Any? = extras[key]
        fun hasThrowable() = failed
    }
    protected open fun beforeHookedMethod(param: MethodHookParam) {}
    protected open fun afterHookedMethod(param: MethodHookParam) {}
    fun before(param: MethodHookParam) = beforeHookedMethod(param)
    fun after(param: MethodHookParam) = afterHookedMethod(param)
}
class Adapter
class Row(var tag: Any? = null)
private class DetailsHarness {
    data class Config(var enabled: Boolean)
    data class MessageDetailsBindState(val holder: Any?, val root: Row? = null, var message: Any? = null)
    val messageDetailsConfig = Config(false)
    val messageDetailsBindStates = ThreadLocal<ArrayDeque<MessageDetailsBindState>>()
    val bind = 1
    val adapterBinds = listOf(1)
    val adapterClass: Class<*>? = Adapter::class.java
    var captures = 0
    var binds = 0
    var boundMessage: Any? = null
    fun captureMessageDetailsBindState(args: Array<Any?>?): MessageDetailsBindState {
        captures++
        return MessageDetailsBindState(args?.getOrNull(0), args?.getOrNull(0) as? Row, args?.getOrNull(1))
    }
    fun bindBottomMessageDetails(owner: Any?, args: Array<Any?>?, attempt: Int, holder: Any?, message: Any?) {
        binds++; boundMessage = message
    }
    fun logger(message: String, error: Throwable?) { throw AssertionError(message, error) }
    val hook = object : XC_MethodHook() @DETAILS_HOOK@
}
private class BubbleHarness {
    data class BindState(val root: Row?, val nativeHolder: Any?)
    var enabled = false
    var captures = 0
    var restores = 0
    var applies = 0
    fun captureBindState(args: Array<Any?>?): BindState { captures++; return BindState(args?.getOrNull(0) as? Row, null) }
    fun restoreBoundBubble(root: Row) { restores++ }
    fun isNativeMessageHolder(value: Any) = true
    fun applyBubble(args: Array<Any?>?, state: BindState) { applies++ }
    val hook = object : XC_MethodHook() @BUBBLE_HOOK@
}
fun main() {
    val h = DetailsHarness(); val row = Row()
    fun param(message: String = "message") = XC_MethodHook.MethodHookParam(arrayOf(row, message))
    repeat(500) { val p=param(); h.hook.before(p);h.hook.after(p) }
    check(h.captures==0 && h.binds==0 && h.messageDetailsBindStates.get()==null)
    h.messageDetailsConfig.enabled=true
    val outer=param("outer");h.hook.before(outer)
    val nested=param("current");h.hook.before(nested);h.hook.after(nested);h.hook.after(outer)
    check(h.binds==1 && h.boundMessage=="current" && h.messageDetailsBindStates.get()==null)
    val inFlight=param();h.hook.before(inFlight);h.messageDetailsConfig.enabled=false
    val skipped=param();h.hook.before(skipped);h.hook.after(skipped)
    check(h.messageDetailsBindStates.get()?.size==1)
    h.messageDetailsConfig.enabled=true;h.hook.after(inFlight)
    check(h.binds==2 && h.messageDetailsBindStates.get()==null)
    val failed=param();h.hook.before(failed);failed.failed=true;h.hook.after(failed)
    check(h.binds==2 && h.messageDetailsBindStates.get()==null)
    val unrelated=XC_MethodHook.MethodHookParam(arrayOf(row, "wrong"),Any());h.hook.before(unrelated);h.hook.after(unrelated)
    check(h.binds==2 && h.messageDetailsBindStates.get()==null)
    println("PASS: production detail hooks skip 500 disabled binds, pair nested frames across off-on, propagate current message, and clean throwable/foreign-adapter paths")
    val b=BubbleHarness()
    repeat(500) {val p=param();b.hook.before(p);b.hook.after(p)}
    check(b.captures==0 && b.applies==0 && b.restores==0)
    b.enabled=true;val full=param();b.hook.before(full);b.hook.after(full)
    check(b.captures==1 && b.applies==1 && b.restores==1)
    val pending=param();b.hook.before(pending);b.enabled=false
    val off=param();b.hook.before(off);b.hook.after(off);b.hook.after(pending)
    check(b.captures==2 && b.applies==1)
    b.enabled=true;val onAgain=param();b.hook.before(onAgain);b.hook.after(onAgain)
    check(b.applies==2)
    println("PASS: production bubble hooks skip 500 disabled binds and retain per-invocation pairing across nested off-on changes")
}
