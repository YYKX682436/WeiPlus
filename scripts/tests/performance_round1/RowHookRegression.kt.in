import java.util.ArrayDeque

import io.github.libxposed.api.XposedInterface
import h.Hchat.tests.api102.ChainFixture

class Adapter
class Row(var tag: Any? = null)
private class DetailsHarness {
    data class Config(var enabled: Boolean)
    data class MessageDetailsBindState(val holder: Any?, val root: Row? = null, var message: Any? = null)
    val messageDetailsConfig = Config(false)
    val messageDetailsBindStates = ThreadLocal<ArrayDeque<MessageDetailsBindState>>()
    val bind = 1
    val adapterBinds = listOf(1)
    val adapterClass: Class<*>? = Adapter::class.java
    var captures = 0
    var binds = 0
    var boundMessage: Any? = null
    fun captureMessageDetailsBindState(args: Array<Any?>?): MessageDetailsBindState {
        captures++
        return MessageDetailsBindState(args?.getOrNull(0), args?.getOrNull(0) as? Row, args?.getOrNull(1))
    }
    fun bindBottomMessageDetails(owner: Any?, args: Array<Any?>?, attempt: Int, holder: Any?, message: Any?) {
        binds++; boundMessage = message
    }
    fun logger(message: String, error: Throwable?) { throw AssertionError(message, error) }
    val hook = XposedInterface.Hooker @DETAILS_HOOK@
}
private class BubbleHarness {
    data class BindState(val root: Row?, val nativeHolder: Any?)
    var enabled = false
    val boundRoots = HashSet<Row>()
    var captures = 0
    var restores = 0
    var applies = 0
    fun captureBindState(args: Array<Any?>?): BindState { captures++; return BindState(args?.getOrNull(0) as? Row, null) }
    fun restoreBoundBubble(root: Row) { restores++;boundRoots.remove(root) }
    fun isNativeMessageHolder(value: Any) = true
    fun applyBubble(args: Array<Any?>?, state: BindState) { applies++;state.root?.let(boundRoots::add) }
    val hook = XposedInterface.Hooker @BUBBLE_HOOK@
}
private fun invoke(hook: XposedInterface.Hooker, row: Row, message: String = "message", owner: Any = Adapter(), native: () -> Any? = { "native-result" }): Any? {
    val chain=ChainFixture(String::class.java.getMethod("length"),owner,arrayOf(row,message)) { _, _ -> native() }
    return chain.run(hook).also { check(chain.proceeds==1) }
}
fun main() {
    val h = DetailsHarness(); val row = Row()
    repeat(500) { check(invoke(h.hook,row)=="native-result") }
    check(h.captures==0 && h.binds==0 && h.messageDetailsBindStates.get()==null)
    h.messageDetailsConfig.enabled=true
    invoke(h.hook,row,"outer") { invoke(h.hook,row,"current") }
    check(h.binds==1 && h.boundMessage=="current" && h.messageDetailsBindStates.get()==null)
    invoke(h.hook,row) {
        h.messageDetailsConfig.enabled=false
        invoke(h.hook,row)
        check(h.messageDetailsBindStates.get()?.size==1)
        h.messageDetailsConfig.enabled=true
    }
    check(h.binds==2 && h.messageDetailsBindStates.get()==null)
    val nativeFailure=IllegalStateException("native binding failed")
    check(runCatching { invoke(h.hook,row) { throw nativeFailure } }.exceptionOrNull() === nativeFailure)
    check(h.binds==2 && h.messageDetailsBindStates.get()==null)
    invoke(h.hook,row,"wrong",Any())
    check(h.binds==2 && h.messageDetailsBindStates.get()==null)
    // An inner failed bind must unwind its frame without consuming its outer frame.
    invoke(h.hook,row,"outer after failure") {
        check(runCatching { invoke(h.hook,row,"failed inner") { throw nativeFailure } }.exceptionOrNull()===nativeFailure)
        check(h.messageDetailsBindStates.get()?.size==1)
    }
    check(h.binds==3 && h.messageDetailsBindStates.get()==null)
    println("PASS: production detail interceptor skips 500 disabled binds, pairs nested off-on frames, propagates current message and host exceptions, and always unwinds frames")
    val b=BubbleHarness()
    repeat(500) {invoke(b.hook,row)}
    check(b.captures==0 && b.applies==0 && b.restores==0)
    b.enabled=true
    invoke(b.hook,row) {check(b.restores==1 && b.applies==0); "native-result"}
    check(b.captures==1 && b.applies==1 && b.restores==1)
    invoke(b.hook,row) {b.enabled=false;invoke(b.hook,row)}
    check(b.captures==2 && b.applies==1)
    b.enabled=true;invoke(b.hook,row)
    check(b.applies==2)
    check(runCatching {invoke(b.hook,row) {throw nativeFailure}}.exceptionOrNull()===nativeFailure)
    check(b.applies==2 && b.restores==4)
    println("PASS: production bubble interceptor restores before native bind, draws only after success while enabled, and preserves native exception identity")
}
